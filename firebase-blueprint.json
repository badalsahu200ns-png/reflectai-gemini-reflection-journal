{
  "entities": {
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A user personal reflection journal entry with conversation history, location, and Gemini synthesis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the journal entry"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID from Firebase Auth"
        },
        "title": {
          "type": "string",
          "description": "Title of the journal reflection",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Category of the reflection",
          "maxLength": 50
        },
        "mood": {
          "type": "string",
          "description": "Emotional mindset / mood",
          "maxLength": 50
        },
        "tags": {
          "type": "array",
          "description": "List of thematic tags"
        },
        "turns": {
          "type": "array",
          "description": "Multi-turn reflection conversation turns between user and Gemini"
        },
        "summary": {
          "type": "object",
          "description": "Structured AI summary and growth insights"
        },
        "moodAnalysis": {
          "type": "object",
          "description": "AI-powered mood sentiment and energy scoring"
        },
        "location": {
          "type": "object",
          "description": "Optional geographic location of reflection"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether entry is pinned to top of history"
        },
        "wordCount": {
          "type": "number",
          "description": "Total user word count"
        }
      },
      "required": ["id", "userId", "title", "category", "createdAt", "updatedAt"]
    },
    "WeeklyAISummary": {
      "title": "WeeklyAISummary",
      "description": "Synthesized weekly reflection overview generated by Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "weekStartDate": { "type": "string" },
        "weekEndDate": { "type": "string" },
        "entryCount": { "type": "number" },
        "totalWords": { "type": "number" },
        "executiveSummary": { "type": "string" },
        "emotionalTrajectory": { "type": "string" },
        "keyBreakthroughs": { "type": "array" },
        "recurringChallenges": { "type": "array" },
        "actionPlan": { "type": "array" },
        "nextWeekPrompts": { "type": "array" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "weekStartDate", "weekEndDate", "executiveSummary", "generatedAt"]
    },
    "MonthlyAISummary": {
      "title": "MonthlyAISummary",
      "description": "Synthesized monthly reflection overview generated by Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "month": { "type": "string" },
        "entryCount": { "type": "number" },
        "totalWords": { "type": "number" },
        "executiveSummary": { "type": "string" },
        "monthlyThemes": { "type": "array" },
        "moodTrendNarrative": { "type": "string" },
        "recurringConcerns": { "type": "array" },
        "progressAndMilestones": { "type": "array" },
        "comparisonWithPrevious": { "type": "string" },
        "reflectionQuestions": { "type": "array" },
        "nextMonthIntentions": { "type": "array" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "month", "executiveSummary", "generatedAt"]
    },
    "AIMemory": {
      "title": "AIMemory",
      "description": "Extracted personal long-term memory points and facts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "sourceEntryId": { "type": "string" },
        "createdAt": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "userId", "text", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User custom settings, reflection persona, and privacy preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reflectionPersona": { "type": "string" },
        "reflectionLength": { "type": "string" },
        "aiMemoryEnabled": { "type": "boolean" },
        "gamificationEnabled": { "type": "boolean" },
        "theme": { "type": "string" },
        "dailyReminderTime": { "type": "string" },
        "dailyReminderEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "reflectionPersona", "aiMemoryEnabled"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System and user action audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "category": { "type": "string" },
        "resource": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "action", "status"]
    },
    "IntegrationConfig": {
      "title": "IntegrationConfig",
      "description": "User connected external notification integration metadata (Email, Slack, Discord) without storing raw credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "type": "string" },
        "connectedAt": { "type": "string" },
        "lastUsedAt": { "type": "string" },
        "workspaceName": { "type": "string" },
        "channelName": { "type": "string" },
        "emailAddress": { "type": "string" },
        "webhookUrlSnippet": { "type": "string" },
        "payloadLevel": { "type": "string" },
        "enabledEvents": { "type": "array" },
        "triggerTag": { "type": "string" }
      },
      "required": ["id", "userId", "provider", "status", "payloadLevel"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Log of dispatched external and in-app notifications without sensitive journal content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "provider": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "errorCode": { "type": "string" },
        "errorMessage": { "type": "string" },
        "latencyMs": { "type": "number" }
      },
      "required": ["id", "userId", "provider", "eventType", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User isolated personal journal reflections"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "AIMemory",
      "description": "User isolated AI long-term memory points"
    },
    "/users/{userId}/weeklySummaries/{summaryId}": {
      "schema": "WeeklyAISummary",
      "description": "User weekly synthesized reflections"
    },
    "/users/{userId}/monthlySummaries/{summaryId}": {
      "schema": "MonthlyAISummary",
      "description": "User monthly synthesized reflections"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "UserPreferences",
      "description": "User custom settings, persona, and privacy preferences"
    },
    "/users/{userId}/integrations/{integrationId}": {
      "schema": "IntegrationConfig",
      "description": "User connected external notification integration settings"
    },
    "/users/{userId}/notificationLogs/{logId}": {
      "schema": "NotificationLog",
      "description": "User notification delivery logs and delivery telemetry"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "System-wide immutable security and operation audit trail"
    }
  }
}
